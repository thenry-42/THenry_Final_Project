<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFF3E0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        tools:context=".WelcomeFragment">

        <TextView
            android:id="@+id/smoothieIconText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🍓🍉🍒🍑"
            android:textSize="50sp"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/gameTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Snack Shack Shuffle"
            android:textSize="34sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#75451F" />

        <TextView
            android:id="@+id/welcomeMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Make smoothies, serve customers, and earn points!"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:textColor="#75451F" />

        <TextView
            android:id="@+id/shopNameLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Name Your Smoothie Shop!"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#75451F"
            android:gravity="center"
            android:layout_marginTop="24dp" />

        <EditText
            android:id="@+id/shopNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter your shop name"
            android:inputType="textCapSentences"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:textColor="#75451F"
            android:textColorHint="#A18870" />

        <Button
            android:id="@+id/startGameButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start Game"
            android:layout_marginTop="24dp"
            android:backgroundTint="#E8A64B"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/howToPlayButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="How to Play"
            android:layout_marginTop="8dp"
            android:backgroundTint="#F5D7AD"
            android:textColor="#75451F" />

    </LinearLayout>
</ScrollView>